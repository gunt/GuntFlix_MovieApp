# Database Configuration - use this for local dev
DATABASE_URL=mongodb://localhost:27017/myFlixDB

# For deployment (MongoDB Atlas) - uncomment and fill when ready:
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/myFlixDB?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server Port
PORT=5000
