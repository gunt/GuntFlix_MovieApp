{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/login",
      "dest": "index.js"
    },
    {
      "src": "/users(.*)",
      "dest": "index.js"
    },
    {
      "src": "/movies(.*)",
      "dest": "index.js"
    },
    {
      "src": "/genres/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/directors/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/index.html"
    }
  ]
}